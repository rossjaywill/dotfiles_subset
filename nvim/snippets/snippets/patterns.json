{
    "Copy and Swap Idiom": {
        "prefix": "copy_swap",
        "body": [
            "class ${1:ClassName} {",
            "public:",
            "    ${1:ClassName}(const ${1:ClassName}& other) : ${1:ClassName}() {",
            "        // Copy constructor implementation",
            "    }",
            "    ${1:ClassName}(${1:ClassName}&& other) noexcept : ${1:ClassName}() {",
            "        swap(*this, other);",
            "    }",
            "    ${1:ClassName}& operator=(${1:ClassName} other) {",
            "        swap(*this, other);",
            "        return *this;",
            "    }",
            "    friend void swap(${1:ClassName}& a, ${1:ClassName}& b) noexcept {",
            "        // Implement swap logic",
            "    }",
            "};"
        ],
        "description": "Copy and Swap Idiom for a class"
    },
    "Pimpl Idiom": {
        "prefix": "pimpl",
        "body": [
            "class ${1:ClassName}Impl;  // forward declaration",
            "",
            "class ${1:ClassName} {",
            "public:",
            "    ${1:ClassName}();",
            "    ~${1:ClassName}();",
            "    ${1:ClassName}(const ${1:ClassName}&);",
            "    ${1:ClassName}& operator=(const ${1:ClassName}&);",
            "",
            "    // Public interface goes here",
            "",
            "private:",
            "    std::unique_ptr<${1:ClassName}Impl> impl;",
            "};"
        ],
        "description": "Pimpl Idiom (Pointer to Implementation)"
    },
    "CRTP": {
        "prefix": "crtp",
        "body": [
            "template<typename Derived>",
            "class ${1:BaseName} {",
            "public:",
            "    void interfaceMethod() {",
            "        static_cast<Derived*>(this)->implementationMethod();",
            "    }",
            "    // ... other generic methods and members ...",
            "};",
            "",
            "class ${2:DerivedClass} : public ${1:BaseName}<${2:DerivedClass}> {",
            "public:",
            "    void implementationMethod() {",
            "        ${0:// Implementation specific to DerivedClass}",
            "    }",
            "};"
        ],
        "description": "Curiously Recurring Template Pattern (CRTP)"
    },
    "State Pattern with std::variant": {
        "prefix": "state_pattern",
        "body": [
            "class ${1:Context};",
            "",
            "class ${2:StateA} {",
            "public:",
            "    void handle(${1:Context}& context);",
            "};",
            "",
            "class ${3:StateB} {",
            "public:",
            "    void handle(${1:Context}& context);",
            "};",
            "",
            "class ${1:Context} {",
            "public:",
            "    void request() {",
            "        std::visit([&](auto& state) { state.handle(*this); }, currentState);",
            "    }",
            "",
            "    // Other member functions",
            "private:",
            "    std::variant<${2:StateA}, ${3:StateB}> currentState = ${2:StateA}{};",
            "};",
            "",
            "void ${2:StateA}::handle(${1:Context}& context) {",
            "    // Handle the request for StateA",
            "    context.currentState = ${3:StateB}{};",
            "}",
            "",
            "void ${3:StateB}::handle(${1:Context}& context) {",
            "    // Handle the request for StateB",
            "    context.currentState = ${2:StateA}{};",
            "}",
            "",
            "${0:// Use the Context and its state-dependent behavior}"
        ],
        "description": "State Pattern using std::variant and compile-time polymorphism"
    },
    "Strategy Pattern with std::function": {
        "prefix": "strategy_pattern",
        "body": [
            "class ${1:StrategyContext} {",
            "public:",
            "    using Strategy = std::function<void()>;",
            "",
            "    ${1:StrategyContext}(Strategy initStrategy) : strategy(std::move(initStrategy)) {}",
            "",
            "    void execute() {",
            "        strategy();",
            "    }",
            "",
            "    void setStrategy(Strategy newStrategy) {",
            "        strategy = std::move(newStrategy);",
            "    }",
            "",
            "private:",
            "    Strategy strategy;",
            "};",
            "",
            "${1:StrategyContext} context([]{ ${0:// Initial strategy implementation here} });"
        ],
        "description": "Strategy Pattern using std::function and lambdas"
    },
     "Builder Pattern": {
        "prefix": "builder_pattern",
        "body": [
            "class ${1:Product} {",
            "public:",
            "    // Product's member variables and functions",
            "};",
            "",
            "class ${1:Product}Builder {",
            "public:",
            "    ${1:Product}Builder& set${2:AttributeA}(const ${3:TypeA}& value) {",
            "        product.${2:AttributeA} = value;",
            "        return *this;",
            "    }",
            "",
            "    ${1:Product}Builder& set${4:AttributeB}(const ${5:TypeB}& value) {",
            "        product.${4:AttributeB} = value;",
            "        return *this;",
            "    }",
            "",
            "    ${1:Product} build() const {",
            "        return product;",
            "    }",
            "",
            "private:",
            "    ${1:Product} product;",
            "};",
            "",
            "${1:Product} product = ${1:Product}Builder().set${2:AttributeA}(${6:valueA}).set${4:AttributeB}(${7:valueB}).build();",
            "${0:// Use the built product}"
        ],
        "description": "Builder Pattern with fluent interface"
    },
    "Static Polymorphism Factory Pattern": {
        "prefix": "static_factory_pattern",
        "body": [
            "template <typename Derived>",
            "class ${1:Product} {",
            "public:",
            "    void operation() {",
            "        static_cast<Derived*>(this)->implementation();",
            "    }",
            "    // Other common product interface functions",
            "};",
            "",
            "class ${2:ConcreteProductA} : public ${1:Product}<${2:ConcreteProductA}> {",
            "public:",
            "    void implementation() {",
            "        ${0:// Implementation for ConcreteProductA}",
            "    }",
            "};",
            "",
            "class ${3:ConcreteProductB} : public ${1:Product}<${3:ConcreteProductB}> {",
            "public:",
            "    void implementation() {",
            "        ${0:// Implementation for ConcreteProductB}",
            "    }",
            "};",
            "",
            "template <typename T>",
            "class ${4:Factory} {",
            "public:",
            "    std::unique_ptr<T> createProduct() {",
            "        return std::make_unique<T>();",
            "    }",
            "};",
            "",
            "${4:Factory}<${2:ConcreteProductA}> factoryA;",
            "auto productA = factoryA.createProduct();",
            "productA->operation();"
        ],
        "description": "Factory Pattern with static polymorphism"
    },
    "Observer Pattern": {
        "prefix": "observer_pattern",
        "body": [
            "class ${1:Subject};",
            "",
            "class ${2:Observer} {",
            "public:",
            "    virtual void update(const ${1:Subject}& subject) = 0;",
            "};",
            "",
            "class ${1:Subject} {",
            "public:",
            "    void attach(std::shared_ptr<${2:Observer}> observer) {",
            "        observers.push_back(observer);",
            "    }",
            "",
            "    void notify() {",
            "        for (const auto& obs : observers) {",
            "            obs->update(*this);",
            "        }",
            "    }",
            "",
            "private:",
            "    std::vector<std::shared_ptr<${2:Observer}>> observers;",
            "};"
        ],
        "description": "Observer Pattern"
    },
    "Adapter Pattern": {
        "prefix": "adapter_pattern",
        "body": [
            "class ${1:OldInterface} {",
            "public:",
            "    void oldMethod() {",
            "        ${0:// old method implementation}",
            "    }",
            "};",
            "",
            "class ${2:NewInterface} {",
            "public:",
            "    virtual void newMethod() = 0;",
            "};",
            "",
            "class ${3:Adapter} : public ${2:NewInterface} {",
            "public:",
            "    ${3:Adapter}(const std::shared_ptr<${1:OldInterface}>& oldObject) : oldObject(oldObject) {}",
            "",
            "    void newMethod() override {",
            "        oldObject->oldMethod();",
            "    }",
            "",
            "private:",
            "    std::shared_ptr<${1:OldInterface}> oldObject;",
            "};"
        ],
        "description": "Adapter Pattern"
    },
    "Command Pattern": {
        "prefix": "command_pattern",
        "body": [
            "class ${1:Command} {",
            "public:",
            "    virtual void execute() = 0;",
            "};",
            "",
            "class ${2:ConcreteCommand} : public ${1:Command} {",
            "public:",
            "    ${2:ConcreteCommand}(std::function<void()> func) : action(func) {}",
            "",
            "    void execute() override {",
            "        action();",
            "    }",
            "",
            "private:",
            "    std::function<void()> action;",
            "};",
            "",
            "class ${3:Invoker} {",
            "public:",
            "    void setCommand(const std::shared_ptr<${1:Command}>& cmd) {",
            "        command = cmd;",
            "    }",
            "",
            "    void trigger() {",
            "        if(command) command->execute();",
            "    }",
            "",
            "private:",
            "    std::shared_ptr<${1:Command}> command;",
            "};"
        ],
        "description": "Command Pattern"
    }
}
